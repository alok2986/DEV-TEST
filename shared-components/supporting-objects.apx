supportingObject restaurant-objects (
    installation {
        objectNames: [
            DEV_MENU_ITEMS
            DEV_CONTACT_MESSAGES
        ]
    }
    installationMessages {
        installSuccess: ```
        Restaurant database objects installed.
        ```
    }

    installScript create-restaurant-tables (
        name: Create Restaurant Tables
        execution {
            sequence: 10
        }
        script {
            content: ```
            declare
                l_count number;
            begin
                select count(*)
                  into l_count
                  from user_tables
                 where table_name = 'DEV_MENU_ITEMS';

                if l_count = 0 then
                    execute immediate q'[
                        create table dev_menu_items (
                            id           number generated by default on null as identity
                                         constraint dev_menu_items_pk primary key,
                            item_name    varchar2(100) not null,
                            category     varchar2(50)  not null,
                            price        number(8,2)   not null,
                            availability varchar2(20)  not null
                        )
                    ]';
                end if;

                select count(*)
                  into l_count
                  from user_tables
                 where table_name = 'DEV_CONTACT_MESSAGES';

                if l_count = 0 then
                    execute immediate q'[
                        create table dev_contact_messages (
                            id            number generated by default on null as identity
                                          constraint dev_contact_messages_pk primary key,
                            customer_name varchar2(100) not null,
                            email         varchar2(255),
                            phone         varchar2(30),
                            message       varchar2(4000),
                            created_on    timestamp default systimestamp not null
                        )
                    ]';
                end if;

                merge into dev_menu_items d
                using (
                    select 'Margherita Pizza' item_name, 'Pizza' category, 9.99 price, 'Available' availability from dual union all
                    select 'Veggie Burger', 'Burgers', 7.49, 'Available' from dual union all
                    select 'Pasta Alfredo', 'Pasta', 8.99, 'Available' from dual union all
                    select 'Fresh Lemonade', 'Drinks', 2.99, 'Available' from dual
                ) s
                   on (d.item_name = s.item_name)
                 when not matched then
                   insert (item_name, category, price, availability)
                   values (s.item_name, s.category, s.price, s.availability);
            end;
            /
            ```
        }
    )
)
